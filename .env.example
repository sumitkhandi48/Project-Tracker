# ==============================================================================
# Project Tracking Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit `.env.local` or expose production secrets to Git.
# `.env.local` is included in `.gitignore` and must remain strictly untracked.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MANDATORY)
# ------------------------------------------------------------------------------
# Standard connection string for MongoDB.
#
# LOCAL STANDALONE INSTANCE (Default):
# Connects to standard local Community Server. Note that standalone instances
# do NOT support multi-document ACID transactions; project cascade deletion will
# safely fail closed with HTTP 501.
MONGODB_URI=mongodb://127.0.0.1:27017/project_tracker

# PRODUCTION / CLUSTER DEPLOYMENT (MongoDB Atlas or Local Replica Set):
# Multi-document transactions are REQUIRED for atomic project cascade deletion.
# MongoDB Atlas clusters support replica sets by default:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. NextAuth.js Authentication & Session Security (MANDATORY)
# ------------------------------------------------------------------------------
# Secret key used to sign and encrypt JWT session tokens and cookies.
# Generate a secure 32-byte string using OpenSSL or Node:
#   openssl rand -base64 32
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your_nextauth_secret_here_replace_with_random_32_char_string

# Canonical base URL of the application.
# Local development:
NEXTAUTH_URL=http://localhost:3000
# Production deployment (e.g. Vercel or custom domain):
# NEXTAUTH_URL=https://tracker.yourdomain.com

# ------------------------------------------------------------------------------
# 3. GitHub OAuth Application Credentials (MANDATORY)
# ------------------------------------------------------------------------------
# Register a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000 (or production URL)
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   (In production: https://<your-domain>/api/auth/callback/github)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 4. Owner Authorization Control (MANDATORY)
# ------------------------------------------------------------------------------
# The numeric GitHub account ID of the authorized owner/administrator.
# The platform enforces a single-owner security boundary: only this specific
# GitHub user is granted access to private dashboard and CRUD management APIs.
#
# Obtain your numeric GitHub ID via terminal:
#   curl -s https://api.github.com/users/<your-github-username> | jq .id
# Or in browser:
#   https://api.github.com/users/<your-github-username> (inspect the "id" field)
OWNER_GITHUB_ID=12345678

# ------------------------------------------------------------------------------
# 5. Dedicated Replica Set Test Database (OPTIONAL — TESTING ONLY)
# ------------------------------------------------------------------------------
# Optional connection URI pointing to a dedicated MongoDB replica set used solely
# by `tests/cascade-deletion-replica-set.test.js` to execute genuine multi-document
# transaction integration tests without modifying or conflicting with standalone
# development data.
#
# When omitted, the 5 replica-set integration tests are automatically skipped
# in `npm test` without failing the test suite.
#
# Local test replica set example (e.g. initiated on alternate port 27018):
# MONGODB_REPLICA_TEST_URI=mongodb://127.0.0.1:27018/project_tracker_test?replicaSet=rsTest
