# Database Configuration
# Local MongoDB Community Server (default for local development):
MONGODB_URI=mongodb://127.0.0.1:27017/project_tracker
# MongoDB Atlas placeholder (production / cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# NextAuth / Auth.js Configuration
# Generate a secret using: `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here_replace_with_random_string
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Owner Authorization Control (Server-only)
# The numeric GitHub account ID of the authorized owner (e.g. 12345678)
# Obtain via: `curl -s https://api.github.com/users/<your-github-username> | jq .id`
OWNER_GITHUB_ID=your_numeric_github_id_placeholder
